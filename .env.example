# ---------------------------------------------------------------- core
# PostgreSQL. Locally: docker compose (db service). On Vercel: the Neon integration sets it.
DATABASE_URL=postgres://fsp:fsp@localhost:5432/fsp
# Public base URL used in emails (verification links).
APP_URL=http://localhost:3000
# Auth.js secret: `openssl rand -base64 32`. Required in production.
AUTH_SECRET=
# Needed when running behind a proxy / in docker.
AUTH_TRUST_HOST=true
# Demo mode: shows verification links on screen and demo-account hints on the login page.
DEMO_MODE=true

# ---------------------------------------------------------------- Keycloak ("ФСП ID"), optional
AUTH_KEYCLOAK_ENABLED=false
AUTH_KEYCLOAK_ID=fsp-talents
AUTH_KEYCLOAK_SECRET=fsp-talents-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/fsp

# ---------------------------------------------------------------- mail
MAIL_FROM="ФСП Таланты <no-reply@fsp-talents.local>"
# Local: Mailpit from docker compose (UI on http://localhost:8025).
SMTP_HOST=
SMTP_PORT=1025
# Vercel: Resend API key (free tier). Without it and without SMTP mail is only logged.
RESEND_API_KEY=

# ---------------------------------------------------------------- files
# Vercel Blob token. If empty, files are stored in STORAGE_DIR.
BLOB_READ_WRITE_TOKEN=
STORAGE_DIR=./storage

# ---------------------------------------------------------------- LLM (RouterAI, OpenAI-compatible)
# Empty key -> every LLM feature falls back to deterministic rules.
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna-pro
LLM_MODEL_STRONG=openai/gpt-6-luna-pro
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TIMEOUT_MS=20000

# ---------------------------------------------------------------- rate limiting (optional)
# Without Upstash an in-memory limiter is used (per instance, best effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- GitHub repo checks (optional)
GITHUB_TOKEN=
